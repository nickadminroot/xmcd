		<region region-id="8" left="0" top="525" width="135.75" height="78.75" align-x="37.5" align-y="534" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">stop</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">n</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:localDefine>
							<ml:id xml:space="preserve">acc</ml:id>
							<ml:real>0</ml:real>
						</ml:localDefine>
						<ml:for>
							<ml:id xml:space="preserve">i</ml:id>
							<ml:range>
								<ml:real>1</ml:real>
								<ml:id xml:space="preserve">n</ml:id>
							</ml:range>
							<ml:program>
								<ml:ifThen>
									<ml:apply>
										<ml:greaterThan/>
										<ml:id xml:space="preserve">i</ml:id>
										<ml:real>3</ml:real>
									</ml:apply>
									<ml:break/>
								</ml:ifThen>
								<ml:localDefine>
									<ml:id xml:space="preserve">acc</ml:id>
									<ml:apply>
										<ml:plus/>
										<ml:id xml:space="preserve">acc</ml:id>
										<ml:id xml:space="preserve">i</ml:id>
									</ml:apply>
								</ml:localDefine>
							</ml:program>
						</ml:for>
						<ml:id xml:space="preserve">acc</ml:id>
					</ml:program>
				</ml:define>
			</math>
		</region>
