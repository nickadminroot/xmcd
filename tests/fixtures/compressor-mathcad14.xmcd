			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">Y</ml:id>
					<ml:matrix rows="4" cols="1">
						<ml:real>0</ml:real>
						<ml:apply>
							<ml:id xml:space="preserve">yB</ml:id>
							<ml:id xml:space="preserve">probe</ml:id>
						</ml:apply>
						<ml:apply>
							<ml:id xml:space="preserve">yS</ml:id>
							<ml:id xml:space="preserve">probe</ml:id>
						</ml:apply>
						<ml:apply>
							<ml:id xml:space="preserve">yC</ml:id>
							<ml:id xml:space="preserve">probe</ml:id>
						</ml:apply>
					</ml:matrix>
				</ml:define>
			</math>
		</region>
		<region region-id="49" left="0" top="2301" width="68.25" height="12.75" align-x="13.5" align-y="2310" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">φ</ml:id>
					<ml:range>
						<ml:sequence>
							<ml:real>0</ml:real>
							<ml:real>0.05</ml:real>
						</ml:sequence>
						<ml:apply>
							<ml:mult/>
							<ml:real>2</ml:real>
							<ml:id xml:space="preserve">π</ml:id>
						</ml:apply>
					</ml:range>
				</ml:define>
			</math>
		</region>
		<region region-id="50" left="30" top="2346" width="360.75" height="267.75" align-x="30" align-y="2346" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="mechanism-and-trajectories">
			<plot disable-calc="false" item-idref="1"/>
		</region>
		<region region-id="51" left="30" top="2628" width="394.5" height="252.75" align-x="30" align-y="2628" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="velocity-acceleration">
			<plot disable-calc="false" item-idref="2"/>
		</region>
		<region region-id="52" left="0" top="2868.75" width="399.75" height="14.25" align-x="0" align-y="2880" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Приведённый момент инерции</p>
			</text>
		</region>
		<region region-id="53" left="0" top="2907" width="329.25" height="18.75" align-x="45.75" align-y="2922" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">inertia</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">φ</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:plus/>
						<ml:apply>
							<ml:plus/>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve">J2</ml:id>
								<ml:apply>
									<ml:pow/>
									<ml:apply>
										<ml:id xml:space="preserve">v_phi2</ml:id>
										<ml:id xml:space="preserve">φ</ml:id>
									</ml:apply>
									<ml:real>2</ml:real>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve">mass2</ml:id>
								<ml:parens>
									<ml:apply>
										<ml:plus/>
										<ml:apply>
											<ml:pow/>
											<ml:apply>
												<ml:id xml:space="preserve">v_xS</ml:id>
												<ml:id xml:space="preserve">φ</ml:id>
											</ml:apply>
											<ml:real>2</ml:real>
										</ml:apply>
										<ml:apply>
											<ml:pow/>
											<ml:apply>
												<ml:id xml:space="preserve">v_yS</ml:id>
												<ml:id xml:space="preserve">φ</ml:id>
											</ml:apply>
											<ml:real>2</ml:real>
										</ml:apply>
									</ml:apply>
								</ml:parens>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:id xml:space="preserve">mass3</ml:id>
							<ml:apply>
								<ml:pow/>
								<ml:apply>
									<ml:id xml:space="preserve">v_yC</ml:id>
									<ml:id xml:space="preserve">φ</ml:id>
								</ml:apply>
								<ml:real>2</ml:real>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
		</region>
		<region region-id="54" left="0" top="2967" width="108.75" height="12.75" align-x="61.5" align-y="2976" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="inertia-at-probe">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:apply>
						<ml:id xml:space="preserve">inertia</ml:id>
						<ml:id xml:space="preserve">probe</ml:id>
					</ml:apply>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>0.081071408906996573</ml:real>
					</result>
				</ml:eval>
			</math>
		</region>
		<region region-id="55" left="0" top="3000.75" width="399.75" height="14.25" align-x="0" align-y="3012" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<text use-page-width="false" push-down="false" lock-width="true">
				<p style="Heading 2" margin-left="inherit" margin-right="inherit" text-indent="inherit" text-align="inherit" list-style-type="inherit" tabs="inherit">Табличная индикаторная диаграмма и давление</p>
			</text>
		</region>
		<region region-id="56" left="0" top="3021" width="53.25" height="144.75" align-x="21" align-y="3096" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">sbc</ml:id>
					<ml:matrix rows="9" cols="1">
						<ml:real>0.2</ml:real>
						<ml:real>0.3</ml:real>
						<ml:real>0.4</ml:real>
						<ml:real>0.5</ml:real>
						<ml:real>0.6</ml:real>
						<ml:real>0.7</ml:real>
						<ml:real>0.8</ml:real>
						<ml:real>0.9</ml:real>
						<ml:real>1</ml:real>
					</ml:matrix>
				</ml:define>
			</math>
		</region>
		<region region-id="57" left="0" top="3165" width="59.25" height="144.75" align-x="22.5" align-y="3240" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">pbc</ml:id>
					<ml:matrix rows="9" cols="1">
						<ml:real>1</ml:real>
						<ml:real>0.58</ml:real>
						<ml:real>0.38</ml:real>
						<ml:real>0.26</ml:real>
						<ml:real>0.18</ml:real>
						<ml:real>0.12</ml:real>
						<ml:real>0.07</ml:real>
						<ml:real>0.03</ml:real>
						<ml:real>0</ml:real>
					</ml:matrix>
				</ml:define>
			</math>
		</region>
		<region region-id="58" left="0" top="3316.5" width="54" height="45.75" align-x="21.75" align-y="3342" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">sad</ml:id>
					<ml:matrix rows="3" cols="1">
						<ml:real>0</ml:real>
						<ml:real>0.1</ml:real>
						<ml:real>0.2</ml:real>
					</ml:matrix>
				</ml:define>
			</math>
		</region>
		<region region-id="59" left="0" top="3382.5" width="55.5" height="45.75" align-x="23.25" align-y="3408" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">pad</ml:id>
					<ml:matrix rows="3" cols="1">
						<ml:real>1</ml:real>
						<ml:real>0.3</ml:real>
						<ml:real>0</ml:real>
					</ml:matrix>
				</ml:define>
			</math>
		</region>
		<region region-id="60" left="0" top="3453" width="97.5" height="12.75" align-x="21" align-y="3462" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">cbc</ml:id>
					<ml:apply>
						<ml:id xml:space="preserve">lspline</ml:id>
						<ml:sequence>
							<ml:id xml:space="preserve">sbc</ml:id>
							<ml:id xml:space="preserve">pbc</ml:id>
						</ml:sequence>
					</ml:apply>
				</ml:define>
			</math>
		</region>
		<region region-id="61" left="0" top="3495" width="99.75" height="12.75" align-x="21.75" align-y="3504" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">cad</ml:id>
					<ml:apply>
						<ml:id xml:space="preserve">lspline</ml:id>
						<ml:sequence>
							<ml:id xml:space="preserve">sad</ml:id>
							<ml:id xml:space="preserve">pad</ml:id>
						</ml:sequence>
					</ml:apply>
				</ml:define>
			</math>
		</region>
		<region region-id="62" left="0" top="3555" width="196.5" height="29.25" align-x="35.25" align-y="3564" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">PBC</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">z</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:ifThen>
							<ml:apply>
								<ml:lessThan/>
								<ml:id xml:space="preserve">z</ml:id>
								<ml:real>0.2</ml:real>
							</ml:apply>
							<ml:real>1</ml:real>
						</ml:ifThen>
						<ml:otherwise>
							<ml:apply>
								<ml:id xml:space="preserve">interp</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">cbc</ml:id>
									<ml:id xml:space="preserve">sbc</ml:id>
									<ml:id xml:space="preserve">pbc</ml:id>
									<ml:id xml:space="preserve">z</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:otherwise>
					</ml:program>
				</ml:define>
			</math>
		</region>
		<region region-id="63" left="0" top="3633" width="201" height="29.25" align-x="37.5" align-y="3642" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">PAD</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">z</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:ifThen>
							<ml:apply>
								<ml:greaterThan/>
								<ml:id xml:space="preserve">z</ml:id>
								<ml:real>0.2</ml:real>
							</ml:apply>
							<ml:real>0</ml:real>
						</ml:ifThen>
						<ml:otherwise>
							<ml:apply>
								<ml:id xml:space="preserve">interp</ml:id>
								<ml:sequence>
									<ml:id xml:space="preserve">cad</ml:id>
									<ml:id xml:space="preserve">sad</ml:id>
									<ml:id xml:space="preserve">pad</ml:id>
									<ml:id xml:space="preserve">z</ml:id>
								</ml:sequence>
							</ml:apply>
						</ml:otherwise>
					</ml:program>
				</ml:define>
			</math>
		</region>
		<region region-id="64" left="0" top="3692.25" width="117.75" height="27.75" align-x="45.75" align-y="3708" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">stroke</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">φ</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:div/>
						<ml:apply>
							<ml:minus/>
							<ml:apply>
								<ml:id xml:space="preserve">yC</ml:id>
								<ml:real>0</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">yC</ml:id>
								<ml:id xml:space="preserve">φ</ml:id>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:real>2</ml:real>
							<ml:id xml:space="preserve">l1</ml:id>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
		</region>
		<region region-id="65" left="0" top="3765" width="237.75" height="29.25" align-x="56.25" align-y="3774" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">pressure</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">φ</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:program>
						<ml:ifThen>
							<ml:apply>
								<ml:greaterThan/>
								<ml:apply>
									<ml:id xml:space="preserve">v_yC</ml:id>
									<ml:id xml:space="preserve">φ</ml:id>
								</ml:apply>
								<ml:real>0</ml:real>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve">pmax</ml:id>
								<ml:apply>
									<ml:id xml:space="preserve">PBC</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">stroke</ml:id>
										<ml:id xml:space="preserve">φ</ml:id>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:ifThen>
						<ml:otherwise>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve">pmax</ml:id>
								<ml:apply>
									<ml:id xml:space="preserve">PAD</ml:id>
									<ml:apply>
										<ml:id xml:space="preserve">stroke</ml:id>
										<ml:id xml:space="preserve">φ</ml:id>
									</ml:apply>
								</ml:apply>
							</ml:apply>
						</ml:otherwise>
					</ml:program>
				</ml:define>
			</math>
		</region>
		<region region-id="66" left="0" top="3824.25" width="159.75" height="33.75" align-x="42" align-y="3846" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">force</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">φ</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:div/>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:neg/>
									<ml:apply>
										<ml:id xml:space="preserve">pressure</ml:id>
										<ml:id xml:space="preserve">φ</ml:id>
									</ml:apply>
								</ml:apply>
								<ml:id xml:space="preserve">π</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:pow/>
								<ml:id xml:space="preserve">diameter</ml:id>
								<ml:real>2</ml:real>
							</ml:apply>
						</ml:apply>
						<ml:real>4</ml:real>
					</ml:apply>
				</ml:define>
			</math>
		</region>
		<region region-id="67" left="0" top="3891" width="348.75" height="12.75" align-x="52.5" align-y="3900" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:function>
						<ml:id xml:space="preserve">moment</ml:id>
						<ml:boundVars>
							<ml:id xml:space="preserve">φ</ml:id>
						</ml:boundVars>
					</ml:function>
					<ml:apply>
						<ml:minus/>
						<ml:apply>
							<ml:minus/>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:id xml:space="preserve">force</ml:id>
									<ml:id xml:space="preserve">φ</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">v_yC</ml:id>
									<ml:id xml:space="preserve">φ</ml:id>
								</ml:apply>
							</ml:apply>
							<ml:apply>
								<ml:mult/>
								<ml:apply>
									<ml:mult/>
									<ml:id xml:space="preserve">mass2</ml:id>
									<ml:id xml:space="preserve">gravity</ml:id>
								</ml:apply>
								<ml:apply>
									<ml:id xml:space="preserve">v_yS</ml:id>
									<ml:id xml:space="preserve">φ</ml:id>
								</ml:apply>
							</ml:apply>
						</ml:apply>
						<ml:apply>
							<ml:mult/>
							<ml:apply>
								<ml:mult/>
								<ml:id xml:space="preserve">mass3</ml:id>
								<ml:id xml:space="preserve">gravity</ml:id>
							</ml:apply>
							<ml:apply>
								<ml:id xml:space="preserve">v_yC</ml:id>
								<ml:id xml:space="preserve">φ</ml:id>
							</ml:apply>
						</ml:apply>
					</ml:apply>
				</ml:define>
			</math>
		</region>
		<region region-id="68" left="0" top="3939" width="108.75" height="12.75" align-x="61.5" align-y="3948" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="probe-stroke">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:apply>
						<ml:id xml:space="preserve">stroke</ml:id>
						<ml:id xml:space="preserve">probe</ml:id>
					</ml:apply>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>0.79743758102333617</ml:real>
					</result>
				</ml:eval>
			</math>
		</region>
		<region region-id="69" left="0" top="3981" width="90" height="12.75" align-x="72" align-y="3990" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="probe-pressure">
			<math optimize="false" disable-calc="false">
				<ml:eval placeholderMultiplicationStyle="default" xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:apply>
						<ml:id xml:space="preserve">pressure</ml:id>
						<ml:id xml:space="preserve">probe</ml:id>
					</ml:apply>
					<result xmlns="http://schemas.mathsoft.com/math30">
						<ml:real>0</ml:real>
					</result>
				</ml:eval>
			</math>
		</region>
		<region region-id="70" left="0" top="4017" width="75.75" height="12.75" align-x="57.75" align-y="4026" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="probe-force">
