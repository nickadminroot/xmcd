						<ml:real>0</ml:real>
						<ml:id xml:space="preserve">am1</ml:id>
						<ml:id xml:space="preserve">am1</ml:id>
						<ml:apply>
							<ml:neg/>
							<ml:id xml:space="preserve">am1</ml:id>
						</ml:apply>
						<ml:apply>
							<ml:neg/>
							<ml:id xml:space="preserve">am1</ml:id>
