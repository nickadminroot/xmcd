		<region region-id="19" left="0" top="1056" width="128.25" height="210.75" align-x="86.25" align-y="1164" show-border="false" show-highlight="false" is-protected="false" z-order="0" background-color="inherit" tag="">
			<math optimize="false" disable-calc="false">
				<ml:define xmlns:ml="http://schemas.mathsoft.com/math30">
					<ml:id xml:space="preserve">acceleration_values</ml:id>
